<mujoco model="go1 obstacles scene">
  <include file="go1.xml"/>

  <statistic center="2 0 0.1" extent="6"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-25" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.2"/>
    <material name="obstacle" rgba="0.85 0.25 0.20 1"/>
    <material name="waypoint" rgba="0.20 0.80 0.30 0.6"/>
  </asset>

  <worldbody>
    <light pos="2 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Slalom obstacles. -->
    <geom name="obs1" type="cylinder" pos="1.2  0.30 0.25" size="0.13 0.25"
          material="obstacle"/>
    <geom name="obs2" type="cylinder" pos="2.4 -0.30 0.25" size="0.13 0.25"
          material="obstacle"/>
    <geom name="obs3" type="cylinder" pos="3.6  0.30 0.25" size="0.13 0.25"
          material="obstacle"/>
    <geom name="obs4" type="cylinder" pos="4.8 -0.30 0.25" size="0.13 0.25"
          material="obstacle"/>

    <!-- Waypoint markers (visual only). -->
    <site name="wp1" pos="1.2 -0.55 0.02" size="0.08" type="sphere" material="waypoint"/>
    <site name="wp2" pos="2.4  0.55 0.02" size="0.08" type="sphere" material="waypoint"/>
    <site name="wp3" pos="3.6 -0.55 0.02" size="0.08" type="sphere" material="waypoint"/>
    <site name="wp4" pos="4.8  0.55 0.02" size="0.08" type="sphere" material="waypoint"/>
    <site name="wp5" pos="6.0  0.00 0.02" size="0.10" type="sphere" material="waypoint"/>
  </worldbody>
</mujoco>
